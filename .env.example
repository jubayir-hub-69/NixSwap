# Deployer key for the Sepolia testnets. Use a testnet-only key.
PRIVATE_KEY=

# Optional RPC overrides. Defaults match the CoFHE Hardhat plugin and docs.
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Render Web Service solver. Unset SOLVER_CHAINS watches Arbitrum Sepolia and Base Sepolia.
# Examples: 421614,84532    or    all    or    "Arbitrum Sepolia"
# SOLVER_CHAINS=421614,84532
# SOLVER_POLL_MS=20000
# PORT=10000
